# ── Required ──────────────────────────────────────────────────────────────────
# Telegram API credentials from https://my.telegram.org/apps
API_ID=1234567
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Your numeric Telegram user ID (owner). Get it from @userinfobot
OWNER_ID=11111111

# Chat/channel where files are uploaded. Bot must be admin there.
DUMP_CHAT_ID=-1001234567890

# ── MongoDB Persistence (Recommended) ─────────────────────────────────────────
# Saves all bot settings, stats, uploaded rclone.conf, and active job checkpoints
# so the bot automatically restores config & resumes jobs when it restarts!
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=rclone_tg_bot

# Auto-resume unfinished transfer jobs automatically on bot startup/restart
AUTO_RESUME_JOBS=true

# ── rclone config (choose ONE, or upload via /setrclone in Telegram) ──────────
# Option A: Upload via /setrclone in Telegram (automatically saved in MongoDB!)
# Option B: A URL to a raw rclone.conf (e.g. a GitHub gist /raw link)
# RCLONE_CONF_URL=https://gist.github.com/you/abc123/raw
# Option C: Inline rclone.conf with literal \n between lines
# RCLONE_CONF=[Dropbox32]\ntype = dropbox\ntoken = {...}

# ── Optional ──────────────────────────────────────────────────────────────────
# Extra authorized user IDs (comma or semicolon separated). Can also be managed via /auth
# AUTHORIZED_USERS=22222222,33333333

# Where files are temporarily downloaded
DOWNLOAD_DIR=/tmp/rclone_dl

# rclone memory & stream tuning (default 32M buffer keeps container RAM low)
RCLONE_BUFFER_SIZE=32M
RCLONE_STREAMS=4

# Extra flags appended to every rclone command
# RCLONE_FLAGS=--drive-chunk-size 64M

# Split threshold in bytes (default ~1.99 GB for non-premium Telegram)
SPLIT_SIZE=2044723200

# Concurrent files per job (1-5). Use 1 for large files.
CONCURRENT_JOBS=1

# Default upload mode (video or document)
DEFAULT_UPLOAD_MODE=video

# rclone download bandwidth limit (e.g. 8M, 512k, 1G) or leave empty for unlimited
# BW_LIMIT=8M

# Health check HTTP port
HEALTH_PORT=8080

# Seconds between Telegram board edits (2-30)
BOARD_REFRESH_INTERVAL=6.0

# Local fallback file when MONGO_URI is not set
STATS_FILE=/tmp/rclone_bot_stats.json

# ffmpeg CPU pinning / threads (optional)
CPU_CORES=0
# CPU_THREADS=4
