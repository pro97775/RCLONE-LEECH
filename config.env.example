# ==============================================================================
#  Rclone ➔ Telegram Transfer Bot Configuration (config.env.example)
#  Copy to config.env or pass as environment variables in Docker/PaaS
# ==============================================================================

# ── Required Telegram Credentials ─────────────────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:AAH_your_bot_token_here
OWNER_ID=123456789
DUMP_CHAT_ID=-1001234567890

# Optional comma-separated list of additional Telegram user IDs allowed to use the bot
AUTHORIZED_USERS=

# ── MongoDB Persistence (Recommended) ─────────────────────────────────────────
# Persists concurrency setup, file types filter, settings, rclone.conf, stats & unfinished jobs
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=rclone_tg_bot
AUTO_RESUME_JOBS=true

# ── File Types Filter (Saved in MongoDB, configurable via /filetypes or /dl) ──
# Options: all | video | image | document (or comma-separated: video,image)
FILE_TYPES=all

# ── High-Speed Concurrency & Transfer Performance (Saved in MongoDB) ──────────
# CONCURRENT_JOBS: Number of pipelined file jobs (1 to 5; default 2)
CONCURRENT_JOBS=2
# UPLOAD_WORKERS: Parallel MTProto upload chunk workers per file (1 to 16; default 8)
UPLOAD_WORKERS=8
# RCLONE_STREAMS: Multi-thread download streams per file (1 to 32; default 8)
RCLONE_STREAMS=8
# RCLONE_BUFFER_SIZE: In-memory buffer per Rclone transfer (32M, 64M, 128M, 256M)
RCLONE_BUFFER_SIZE=64M
# BW_LIMIT: Optional Rclone download bandwidth cap (e.g. 25M, 50M, or empty for Unlimited)
BW_LIMIT=

# ── Rclone Configuration Bootstrap (Optional — can also upload via /setrclone) ─
RCLONE_CONF_URL=
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
RCLONE_FLAGS=

# ── General Runtime Settings ──────────────────────────────────────────────────
DOWNLOAD_DIR=/tmp/rclone_dl
SPLIT_SIZE=2097152000
DEFAULT_UPLOAD_MODE=video
BOARD_REFRESH_INTERVAL=5.0
PORT=8080
