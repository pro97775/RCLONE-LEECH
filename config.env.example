# ── Required Startup Credentials ──────────────────────────────────────────────
# Only these 4 variables are required to start the bot.
# Every other setting (Dump Chat, rclone.conf, File Types, Speed, Size Cap,
# Split Size, Bandwidth Limit, Rclone Flags, Authorized Users) can be
# controlled and saved to MongoDB directly from the Telegram Bot UI!

API_ID=1234567
API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-DEF...
OWNER_ID=11111111

# ── MongoDB Persistence (Recommended) ─────────────────────────────────────────
# Persists all bot settings, rclone.conf, stats, and active job checkpoints.
# Falls back to local JSON automatically if left blank.
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=rclone_tg_bot

# ── Optional Defaults (All controllable from the Bot Control Panel) ───────────
# DUMP_CHAT_ID defaults to OWNER_ID if omitted; changeable via /setdump or Bot UI
DUMP_CHAT_ID=-1001234567890

# File types filter: all | video | image | document | video,image
FILE_TYPES=all

# Speed & Concurrency defaults (changeable live from ⚡ Speed panel in bot)
CONCURRENT_JOBS=2
UPLOAD_WORKERS=4
RCLONE_STREAMS=8
RCLONE_BUFFER_SIZE=64M

# Split threshold in bytes (default ~2000 MB, changeable from Bot Control Panel)
SPLIT_SIZE=2097152000

# Optional rclone.conf bootstrap (can also be uploaded or pasted in bot via /setrclone)
# RCLONE_CONF_URL=https://gist.github.com/you/abc123/raw
# RCLONE_CONF=[gdrive]\ntype = drive\ntoken = {...}

# Health check HTTP port
HEALTH_PORT=8080
